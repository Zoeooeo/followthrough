<% content_for :title, @care_concern.title %>

<p><%= link_to "Back to #{@resident.name}", resident_path(@resident) %></p>
<h1><%= @care_concern.title %></h1>
<p id="concern-status">Status: <%= status_badge(@care_concern) %></p>
<%= render "care_concerns/progress", concern: @care_concern %>

<%= render "shared/errors", record: @staff_response %>
<%= render "shared/errors", record: @recheck %>
<%= render "shared/errors", record: @failed_assignment %>

<dl>
  <dt>What fixed looks like</dt>
  <dd><%= @care_concern.fixed_goal %></dd>
  <dt>Opened by</dt>
  <dd><%= @care_concern.opened_by.name %> on <%= short_date(@care_concern.created_at) %></dd>
  <% if @care_concern.visit %>
    <dt>Noticed during</dt>
    <dd><%= link_to "The visit on #{short_date(@care_concern.visit.visited_on)}", resident_visit_path(@resident, @care_concern.visit) %></dd>
  <% end %>
  <% if @care_concern.signal_item %>
    <dt>Related signal</dt>
    <dd><%= @care_concern.signal_item.need %></dd>
  <% end %>
  <% if @care_concern.status_reported_fixed? %>
    <dt>Recheck</dt>
    <% if @care_concern.assigned_to %>
      <dd id="recheck-assignee">Recheck assigned to <%= @care_concern.assigned_to.name %></dd>
    <% else %>
      <dd id="recheck-assignee">Not assigned. Anyone except <%= @care_concern.opened_by.name %> can check it.</dd>
    <% end %>
  <% end %>
</dl>

<%# Plans change between visits, so any relative can hand the recheck to someone else while it is still waiting. %>
<% if @care_concern.status_reported_fixed? && @assignee_options.any? %>
  <section id="reassign-recheck" class="panel">
    <%= form_with model: @care_concern, url: resident_care_concern_recheck_assignment_path(@resident, @care_concern), method: :patch do |form| %>
      <div class="field">
        <%= form.label :assigned_to_id, "Reassign the recheck to" %>
        <%= form.collection_select :assigned_to_id, @assignee_options, :id, :name, include_blank: "Anyone in the family" %>
      </div>
      <%= form.submit "Reassign recheck" %>
    <% end %>
  </section>
<% end %>

<% if @care_concern.recheck_allowed? %>
  <% if @care_concern.opened_by == current_user %>
    <section id="recheck-blocked" class="panel">
      <p style="margin: 0">You opened this concern, so another relative needs to recheck it.</p>
    </section>
  <% else %>
    <section id="recheck-form" class="panel">
      <h2 style="margin-top: 0">Record a recheck</h2>

      <% if @care_concern.signal_item %>
        <p class="label"><strong>Check for (from the Signal Card)</strong></p>
        <ul id="recheck-checklist">
          <% @care_concern.signal_item.checklist.each do |item| %>
            <li><%= item %></li>
          <% end %>
        </ul>
      <% end %>

      <%= form_with model: @recheck, url: resident_care_concern_rechecks_path(@resident, @care_concern) do |form| %>
        <fieldset class="field">
          <legend><strong>What did you see?</strong></legend>
          <% @care_concern.allowed_recheck_results.each do |result| %>
            <div class="radio">
              <%= form.radio_button :result, result %>
              <%= form.label "result_#{result}", result.humanize %>
            </div>
          <% end %>
        </fieldset>

        <div class="field">
          <%= form.label :note %>
          <%= form.text_area :note %>
        </div>

        <p class="hint">Saved as checked by <%= current_user.name %>.</p>
        <%= form.submit "Save recheck" %>
      <% end %>
    </section>
  <% end %>
<% end %>

<% if @care_concern.awaiting_staff? %>
  <section id="staff-response-form" class="panel staff">
    <h2 style="margin-top: 0">Record what staff said</h2>
    <p class="hint">Saving changes the status to Reported fixed. A relative still needs to check the fix.</p>

    <%= form_with model: @staff_response, url: resident_care_concern_staff_responses_path(@resident, @care_concern) do |form| %>
      <div class="field">
        <%= form.label :staff_name %>
        <%= form.text_field :staff_name, placeholder: "e.g. Maria R., charge nurse" %>
      </div>

      <div class="field">
        <%= form.label :statement %>
        <%= form.text_area :statement %>
      </div>

      <div class="field">
        <%= form.label :said_on %>
        <%= form.date_field :said_on %>
      </div>

      <% if @assignee_options.any? %>
        <div class="field">
          <%= form.label :recheck_assignee_id %>
          <%= form.collection_select :recheck_assignee_id, @assignee_options, :id, :name, include_blank: "Not assigned yet" %>
          <p class="hint">Pick someone other than <%= @care_concern.opened_by.name %>, ideally whoever visits next.</p>
        </div>
      <% else %>
        <p class="hint" id="invite-hint">
          <%= @care_concern.opened_by.name %> is the only one in this family, so no one else can recheck it yet.
          <%= link_to "Invite another relative", resident_memberships_path(@resident) %>
        </p>
      <% end %>

      <%= form.submit "Save staff response" %>
    <% end %>
  </section>
<% end %>

<section id="history">
  <h2>History</h2>
  <ol class="timeline">
    <li class="family">
      <span class="who">Family · <%= short_date(@care_concern.created_at) %></span><br>
      Opened by <%= @care_concern.opened_by.name %>
    </li>
    <% @care_concern.timeline.each do |entry| %>
      <% if entry.is_a?(StaffResponse) %>
        <li class="staff" id="<%= dom_id(entry) %>">
          <span class="who">Staff said · <%= entry.staff_name %> · <%= short_date(entry.said_on) %> · recorded by <%= entry.recorded_by.name %></span><br>
          "<%= entry.statement %>"
        </li>
      <% else %>
        <li class="family" id="<%= dom_id(entry) %>">
          <span class="who">Family saw · <%= entry.checked_by.name %> · <%= short_date(entry.created_at) %></span><br>
          <strong><%= entry.result_label %></strong><%= ". #{entry.note}" if entry.note.present? %>
        </li>
      <% end %>
    <% end %>
  </ol>
</section>
