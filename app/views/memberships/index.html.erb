<% content_for :title, "Family" %>

<p><%= link_to "Back to #{@resident.name}", resident_path(@resident) %></p>
<h1><%= @resident.name %>'s family</h1>
<p class="disclaimer">Private to family only. Facility staff cannot see this space.</p>

<section id="members">
  <h2>Members · <%= @memberships.size %></h2>
  <ul class="list">
    <% @memberships.each do |membership| %>
      <li id="<%= dom_id(membership) %>">
        <span>
          <%= membership.user.name %><%= " (you)" if membership.user == current_user %><br>
          <span class="muted">Joined <%= short_date(membership.created_at) %></span>
        </span>
        <span class="actions" style="margin-top: 0">
          <%= role_badge(membership) %>
          <% if @organizer && membership.relative? %>
            <%= button_to "Remove", resident_membership_path(@resident, membership), method: :delete, class: "secondary" %>
          <% end %>
        </span>
      </li>
    <% end %>
  </ul>
</section>

<section id="invite" class="panel">
  <h2 style="margin-top: 0">Invite a relative</h2>
  <p>Share this invite code. After signing up, they choose <strong>Join with an invite code</strong> on their home page.</p>
  <p class="invite-code" id="invite-code"><%= @resident.invite_code %></p>
</section>

<section id="roles">
  <h2>What roles can do</h2>
  <p><strong>Organizer:</strong> everything a relative can do, plus removing relatives from the family.</p>
  <p><strong>Relative:</strong> logs visits, edits the Signal Card, opens concerns, records staff responses, and rechecks concerns opened by someone else.</p>
</section>
