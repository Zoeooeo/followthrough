<% content_for :title, @resident.name %>

<p><%= link_to "Back to home", root_path %></p>
<h1><%= @resident.name %></h1>
<% if @resident.location.present? %>
  <p class="muted">Lives at <%= @resident.location %></p>
<% end %>

<nav class="subnav" aria-label="<%= @resident.name %>">
  <%= link_to "Log a visit", new_resident_visit_path(@resident) %>
  <%= link_to "Meeting brief", resident_brief_path(@resident) %>
  <%= link_to "Family members", resident_memberships_path(@resident) %>
  <%= link_to "All concerns", resident_care_concerns_path(@resident) %>
  <% if @resident.organizer?(current_user) %>
    <%= link_to "Edit profile", edit_resident_path(@resident) %>
  <% end %>
</nav>

<section id="rechecks-due" class="panel">
  <h2 style="margin-top: 0">Rechecks due</h2>
  <% if @rechecks_due.any? %>
    <ul class="list">
      <% @rechecks_due.each do |concern| %>
        <li id="<%= dom_id(concern, :recheck) %>">
          <span>
            <%= link_to concern.title, resident_care_concern_path(@resident, concern) %><br>
            <span class="muted">
              Staff say it's fixed.
              <% if concern.assigned_to %>
                Recheck assigned to <%= concern.assigned_to == current_user ? "you" : concern.assigned_to.name %>.
              <% else %>
                Anyone except <%= concern.opened_by.name %> can check it.
              <% end %>
            </span>
          </span>
          <%= status_badge(concern) %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No rechecks due right now.</p>
  <% end %>
</section>

<section id="concerns">
  <h2>Open concerns</h2>
  <% if @open_concerns.any? %>
    <ul class="list">
      <% @open_concerns.each do |concern| %>
        <li id="<%= dom_id(concern) %>">
          <%= link_to concern.title, resident_care_concern_path(@resident, concern) %>
          <%= status_badge(concern) %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No open concerns.</p>
  <% end %>
  <div class="actions">
    <%= link_to "Open a concern", new_resident_care_concern_path(@resident), class: "button" %>
  </div>
</section>

<section id="recent-visits">
  <h2>Recent visits</h2>
  <% if @recent_visits.any? %>
    <ul class="list">
      <% @recent_visits.each do |visit| %>
        <li id="<%= dom_id(visit) %>">
          <span>
            <%= link_to short_date(visit.visited_on), resident_visit_path(@resident, visit) %>
            <span class="muted">· <%= visit.user.name %></span>
          </span>
          <span><%= visit.mood_label %></span>
        </li>
      <% end %>
    </ul>
    <p><%= link_to "All visits", resident_visits_path(@resident) %></p>
  <% else %>
    <p>No visits logged yet.</p>
  <% end %>
</section>

<section id="signal-card">
  <h2>Signal Card</h2>
  <p class="disclaimer">Family observations, not medical judgment. Ask staff or her doctor about anything medical.</p>

  <%= form_with url: resident_path(@resident), method: :get, class: "search" do |form| %>
    <div class="field">
      <%= form.label :q, "Find a signal" %>
      <%= form.text_field :q, value: @query, placeholder: "e.g. thirst, knee, calling out" %>
    </div>
    <%= form.submit "Search", name: nil %>
  <% end %>
  <% if @query.present? %>
    <p class="hint">Showing signals that match "<%= @query %>". <%= link_to "Show all signals", resident_path(@resident) %></p>
  <% end %>

  <% if @signal_items.any? %>
    <% @signal_items.each do |signal| %>
      <div class="card" id="<%= dom_id(signal) %>">
        <h3><%= signal.need %></h3>
        <p class="label">Shows it by</p>
        <p style="margin: 0"><%= signal.shows_by %></p>
        <p class="label">Check for</p>
        <ul>
          <% signal.checklist.each do |item| %>
            <li><%= item %></li>
          <% end %>
        </ul>
        <% if signal.updated_by %>
          <p class="hint">Updated by <%= signal.updated_by.name %> on <%= short_date(signal.updated_at) %></p>
        <% end %>
        <div class="actions">
          <%= link_to "Edit", edit_resident_signal_item_path(@resident, signal) %>
          <%= button_to "Delete", resident_signal_item_path(@resident, signal), method: :delete, class: "secondary" %>
        </div>
      </div>
    <% end %>
  <% elsif @query.present? %>
    <p>No signals match "<%= @query %>".</p>
  <% else %>
    <p>No signals yet. Add how she shows thirst, pain or distress.</p>
  <% end %>

  <p><%= link_to "Add a signal", new_resident_signal_item_path(@resident), class: "button" %></p>
</section>
