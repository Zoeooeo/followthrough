<% content_for :title, "Home" %>

<h1>Your family</h1>

<% if @residents.any? %>
  <ul class="list" id="residents">
    <% @residents.each do |resident| %>
      <li id="<%= dom_id(resident) %>">
        <span><%= link_to resident.name, resident_path(resident) %></span>
        <% if resident.location.present? %>
          <span class="muted">Lives at <%= resident.location %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No profiles yet.</p>
<% end %>

<p><%= link_to "Add a loved one", new_resident_path, class: "button" %></p>
