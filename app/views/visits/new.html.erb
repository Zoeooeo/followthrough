<% content_for :title, "Log a visit" %>

<p><%= link_to "Back to #{@resident.name}", resident_path(@resident) %></p>
<h1>Log a visit</h1>
<p class="muted"><%= @resident.name %> · visited by <%= current_user.name %></p>

<%= render "shared/errors", record: @visit %>

<%= form_with model: [@resident, @visit] do |form| %>
  <div class="field">
    <%= form.label :visited_on %>
    <%= form.date_field :visited_on, max: Date.current %>
  </div>

  <fieldset class="field">
    <legend><strong>How was <%= @resident.name %> today?</strong></legend>
    <% Visit::MOODS.each do |mood| %>
      <div class="radio">
        <%= form.radio_button :mood, mood %>
        <%= form.label "mood_#{mood}", mood.humanize %>
      </div>
    <% end %>
  </fieldset>

  <% signals = @resident.signal_items.order(:need) %>
  <% if signals.any? %>
    <fieldset class="field">
      <legend><strong>Did you notice any signals from the Signal Card?</strong></legend>
      <%= form.collection_check_boxes :signal_item_ids, signals, :id, :need do |box| %>
        <div class="radio"><%= box.check_box %> <%= box.label %></div>
      <% end %>
    </fieldset>
  <% end %>

  <div class="field">
    <%= form.label :notes %>
    <%= form.text_area :notes, placeholder: "e.g. Hands tucked under her arms. Window was open. Ate most of lunch." %>
  </div>

  <% if @waiting_checks.any? || @verified_checks.any? %>
    <section id="visit-rechecks" class="panel">
      <h2 style="margin-top: 0">Check fixes on this visit</h2>
      <% if @my_recheck_count.positive? %>
        <p><strong><%= pluralize(@my_recheck_count, "recheck") %> for you on this visit</strong></p>
      <% end %>

      <% if @waiting_checks.any? %>
        <p class="hint">Staff say these are fixed. Look for each one and choose what you saw, or leave "Didn't check".</p>
        <% @waiting_checks.each do |concern| %>
          <%= render "visits/check", concern: concern %>
        <% end %>
      <% end %>

      <% if @verified_checks.any? %>
        <h3>Already verified</h3>
        <p class="hint">Only mark one of these if the problem came back.</p>
        <% @verified_checks.each do |concern| %>
          <%= render "visits/check", concern: concern %>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <%= form.submit "Save visit" %>
<% end %>
